{
  "id": "secretary-tools",
  "name": "Personal Secretary tools",
  "description": "Bounded owner-only Core and native scheduler bridge",
  "configSchema": {
    "type": "object",
    "required": [
      "owner"
    ],
    "properties": {
      "owner": {
        "type": "string",
        "minLength": 1
      },
      "coreUrl": {
        "type": "string",
        "default": "http://127.0.0.1:8787"
      },
      "approvalTransportQualified": {
        "type": "boolean",
        "default": false
      },
      "schedulerQualified": {
        "type": "boolean",
        "default": false
      }
    },
    "additionalProperties": false
  },
  "version": "0.1.0",
  "categories": [
    "other"
  ],
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "sheets_list",
      "sheets_describe",
      "sheets_read",
      "sheets_search",
      "sheets_preview_change",
      "sheets_append",
      "sheets_update",
      "sheets_get_history",
      "reports_wedding",
      "reminders_create",
      "reminders_list",
      "reminders_get",
      "reminders_reschedule",
      "reminders_pause",
      "reminders_resume",
      "reminders_cancel",
      "reminders_history"
    ]
  }
}
