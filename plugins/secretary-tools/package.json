{
  "name": "@personal-secretary/openclaw-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25 || >=26.12.1"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "test": "bun test test && node --test test/summary-memory.node.mjs",
    "build": "bun run check:types && bun run bundle && openclaw plugins build --root . --entry ./dist/index.js",
    "validate": "bun run check:package && openclaw plugins validate --root . --entry ./dist/index.js --json",
    "build:bridge": "bun build ./src/bridge.ts --target=node --outdir ./dist/bridge",
    "check:package": "bun ./scripts/check-package.ts",
    "bundle": "bun run check:package && bun ./scripts/bundle.ts",
    "pack": "bun run build && bun run validate && openclaw plugins pack --root . --out ./dist/secretary-tools.tgz --json",
    "check:types": "tsc --project tsconfig.json"
  },
  "peerDependencies": {
    "openclaw": "2026.10.7"
  },
  "files": [
    "dist/index.js",
    "openclaw.plugin.json",
    "README.md"
  ],
  "devDependencies": {
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "@types/node": "24"
  },
  "license": "MIT"
}
