{
  "channels": {
    "whatsapp": {
      "dmPolicy": "allowlist",
      "allowFrom": [
        "+15555550123"
      ],
      "groupPolicy": "disabled",
      "selfChatMode": false
    }
  },
  "approvals": {
    "plugin": {
      "enabled": true,
      "mode": "targets",
      "targets": [
        {
          "channel": "whatsapp",
          "to": "+15555550123"
        }
      ]
    }
  },
  "agents": {
    "defaults": {
      "compaction": {
        "memoryFlush": {
          "enabled": false
        }
      }
    }
  },
  "memory": {
    "search": {
      "provider": "none",
      "fallback": "none",
      "query": {
        "maxResults": 3
      },
      "sources": [
        "memory"
      ],
      "rememberAcrossConversations": false
    }
  },
  "plugins": {
    "entries": {
      "memory-core": {
        "config": {
          "dreaming": {
            "enabled": false
          }
        }
      }
    }
  },
  "hooks": {
    "internal": {
      "enabled": false,
      "entries": {
        "session-memory": {
          "enabled": false
        }
      }
    }
  },
  "tools": {
    "allow": [
      "session_status",
      "memory_search",
      "memory_get",
      "sheets_list",
      "sheets_describe",
      "sheets_read",
      "sheets_search",
      "sheets_preview_change",
      "sheets_append",
      "sheets_update",
      "sheets_get_history",
      "reports_wedding",
      "reminders_create",
      "reminders_list",
      "reminders_get",
      "reminders_reschedule",
      "reminders_pause",
      "reminders_resume",
      "reminders_cancel",
      "reminders_history",
      "docs_list",
      "docs_describe",
      "docs_read",
      "docs_preview_change",
      "docs_apply",
      "operations_get_history",
      "sheets_preview_create_tab",
      "sheets_create_tab"
    ],
    "deny": [
      "group:fs",
      "group:runtime",
      "group:automation",
      "message"
    ]
  }
}
