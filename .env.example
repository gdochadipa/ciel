# Template only. Store the real file at /etc/secretary/service.env with mode 0600.
SECRETARY_STATE_DIR=/var/lib/secretary
SECRETARY_WRITES_ENABLED=false
SECRETARY_CONFIG=/etc/secretary/registry.json
SECRETARY_CORE_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SECRETARY_APPROVAL_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
SECRETARY_OWNER=REPLACE_WITH_OPERATOR_BOUND_OWNER
GOOGLE_APPLICATION_CREDENTIALS=/etc/secretary/google-service-account.json
# Production rejects true. Local HTTP stand-ins require explicit mock mode.
SECRETARY_MOCK_MODE=false
# Set mock-only endpoint/token in a disposable environment, never production.
# SECRETARY_GOOGLE_BASE_URL=http://127.0.0.1:4010
# SECRETARY_GOOGLE_TOKEN=DISPOSABLE_FIXTURE_TOKEN
